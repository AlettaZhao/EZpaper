# ---- 飞书自建应用单聊 ----
# FEISHU_APP_ID=cli_xxxxxxxx
# FEISHU_APP_SECRET=
# FEISHU_MOBILE=13812345678
# FEISHU_VERIFICATION_TOKEN=
# FEISHU_OPEN_IDS=ou_xxx,ou_yyy

# ---- 摘要模型（二选一；OpenAI 优先）----
SUMMARY_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_REASONING_EFFORT=low
OPENAI_SUMMARY_MAX_OUTPUT_TOKENS=420
PRECISE_RETRY_ATTEMPTS=2
HUMANIZE_SUMMARY=1
SUMMARY_DISPLAY_MAX_CHARS=48
HUMANIZE_RETRY_ATTEMPTS=2
OPENAI_HUMANIZE_MODEL=gpt-5.5
OPENAI_HUMANIZE_REASONING_EFFORT=low
OPENAI_HUMANIZE_MAX_OUTPUT_TOKENS=360

# SUMMARY_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
ANTHROPIC_SUMMARY_MAX_TOKENS=420
ANTHROPIC_HUMANIZE_MODEL=claude-sonnet-4-6
ANTHROPIC_HUMANIZE_MAX_TOKENS=360

# ---- 你的单用户研究画像 ----
ARXIV_CATEGORIES=cs.HC,cs.AI,cs.CL,cs.CV,cs.GR
MAX_RESULTS_PER_CATEGORY=50
MIN_RELEVANCE_SCORE=3
KEYWORDS=artificial intelligence,AI,large language model,LLM,generative AI,extended reality,XR,virtual reality,VR,augmented reality,AR,mixed reality,MR,design communication,design collaboration,co-design,communication,cross-cultural,cross culture,intercultural,culture,human-computer interaction,HCI
TOP_N=5

# 不联网调卡片时打开
# USE_SAMPLE_PAPERS=1
